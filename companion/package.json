{
  "name": "ai-apprentice-companion",
  "version": "0.1.0",
  "private": true,
  "description": "AI Apprentice desktop app (macOS and Windows): the control room in its own window, plus cursor buddy, side dock, floating panel, shortcuts, activity counts, frontmost app and halo overlay, talking to the page over a preload bridge.",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:dir": "npm run build && electron-builder --mac dir",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "get-windows": "^9.3.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "app.aiapprentice.companion",
    "productName": "AI Apprentice",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "static/**",
      "app.config.json",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/get-windows/**"
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AI Apprentice listens while you talk to your agent (push to talk).",
        "NSScreenCaptureUsageDescription": "AI Apprentice sees your screen while you train or learn, so the agent can follow your work and point at things."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "get-windows@9.3.0": true,
    "uiohook-napi@1.5.5": true
  }
}
