{
  "mcpServers": {
    "bus": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/Users/k3ntaw/code/orchestrator",
        "python",
        "-m",
        "orchestrator.bus_mcp"
      ],
      "env": {
        "ORCH_ROOT": "/Users/k3ntaw/code/ai-apprentice"
      }
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_READ_TOKEN}"
      }
    }
  }
}
