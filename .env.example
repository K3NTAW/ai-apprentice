# Copy to .env.local and fill in; never commit real values.

# ElevenLabs API key
ELEVENLABS_API_KEY=
# ElevenLabs agent ID for the interviewer agent
ELEVENLABS_AGENT_ID_INTERVIEWER=
# ElevenLabs agent ID for the tutor agent
ELEVENLABS_AGENT_ID_TUTOR=
# Anthropic API key (vision and the LLM fallback of the decision layer)
ANTHROPIC_API_KEY=
# Jev API key (optional; without it the decision layer uses the LLM fallback)
JEV_API_KEY=
# Supabase project URL (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public, RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for the verified user the proxy forwards to the page render (optional, server only). Unset: derived from
# SUPABASE_SERVICE_ROLE_KEY. Neither set: one warning, and every page calls getUser twice.
FORWARDED_USER_SECRET=
