# Copy to .env.local and fill in; never commit real values. Desktop release secrets live in docs/RELEASE.md, not here.

# ElevenLabs API key
ELEVENLABS_API_KEY=
# ElevenLabs agent ID for the interviewer agent
ELEVENLABS_AGENT_ID_INTERVIEWER=
# ElevenLabs agent ID for the tutor agent
ELEVENLABS_AGENT_ID_TUTOR=
# Anthropic API key (vision and the LLM fallback of the decision layer)
ANTHROPIC_API_KEY=
# Jev API key (optional; without it the decision layer uses the LLM fallback)
JEV_API_KEY=
# Supabase project URL (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public, RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Optional, server only: HMAC key for the user the proxy forwards to the page render (unset: derived from the service role key)
FORWARDED_USER_SECRET=
# Bearer secret for the retention cron (/api/cron/retention), server only, at least 16 characters
CRON_SECRET=

# Optional: force the decision provider (jev, llm or heuristic)
DECIDE_PROVIDER=
# Optional: Jev model id (default jev-latest)
JEV_MODEL=
# Optional: vision model override (default and fallback in src/lib/models.ts, see docs/checks/models.md)
VISION_MODEL=
# Optional: decision model override
DECIDE_MODEL=
# Optional: Work Map synthesis model override
WORKMAP_MODEL=
# Optional: Presidio server for redaction (local recognizers otherwise)
PRESIDIO_URL=

# Optional: daily vision cap per workspace (default 3000)
USAGE_CAP_VISION=
# Optional: daily decide cap per workspace (default 2000)
USAGE_CAP_DECIDE=
# Optional: daily Work Map synthesis cap per workspace (default 50)
USAGE_CAP_WORKMAP=
# Optional: daily voice session cap per workspace (default 60)
USAGE_CAP_VOICE=
# Cost meter: 0 turns off usage_events recording (default on in Supabase mode)
USAGE_EVENTS=

# Frames: 1 stores every frame (rollback); default stores only frames with a non-routine (key) event
STORE_ALL_FRAMES=
# Local mode data directory (default ./data)
DATA_DIR=
# 0, false, off or no turns off the onboarding flow (default on)
ONBOARDING_ENABLED=
# 1 logs server timings
PERF_LOG=

# Sentry, server (nodejs runtime). Empty: Sentry is off. See docs/OBSERVABILITY.md
SENTRY_DSN=
# Sentry, browser. Inlined at build time: unset AND rebuild to turn it off
NEXT_PUBLIC_SENTRY_DSN=

# Optional: marketing site URL, linked from the login screen
NEXT_PUBLIC_MARKETING_URL=
# Optional: https download link for the macOS desktop app
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=
# Optional: https download link for the Windows desktop app
NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=
# Optional: 1 turns on the old local WebSocket companion in the browser (default off)
NEXT_PUBLIC_COMPANION_WS=
# Optional: ask cadence, active (default) or classic (rollback)
NEXT_PUBLIC_ASK_CADENCE=
# Optional: 1 allows TTS overrides on the voice agents (default off)
NEXT_PUBLIC_TTS_OVERRIDES=

# npm run test:db only: Supabase CLI local stack URL (supabase status -o env), never a hosted project; see docs/checks/db-tests.md
SUPABASE_TEST_URL=
# npm run test:db only: local stack anon key
SUPABASE_TEST_ANON_KEY=
# npm run test:db only: local stack service role key
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Optional, npm run test:db only: one more host the db-tests target guard accepts besides localhost and 127.0.0.1
SUPABASE_TEST_ALLOWED_HOST=
