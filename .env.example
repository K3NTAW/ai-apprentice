# Copy to .env.local and fill in; never commit real values.

# ElevenLabs API key
ELEVENLABS_API_KEY=
# ElevenLabs agent ID for the interviewer agent
ELEVENLABS_AGENT_ID_INTERVIEWER=
# ElevenLabs agent ID for the tutor agent
ELEVENLABS_AGENT_ID_TUTOR=
# Anthropic API key (vision and the LLM fallback of the decision layer)
ANTHROPIC_API_KEY=
# Jev API key (optional; without it the decision layer uses the LLM fallback)
JEV_API_KEY=
